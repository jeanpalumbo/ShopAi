# AI Commerce OS - variables de entorno de ejemplo.
# Copia este archivo a .env y completa valores reales localmente.
# Nunca commitees .env ni pegues secretos en este archivo de ejemplo.

# Perfil de ejecucion: offline (por defecto, sin llamadas externas), sandbox, live
AICOS_PROFILE=offline

# Modelo / proveedor de inferencia (dejar vacio hasta confirmar credencial autorizada)
AICOS_MODEL_PROVIDER=
AICOS_MODEL_API_KEY=

# Shopify (dejar vacio hasta confirmar tienda, scopes y acceso legitimo)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=

# Base de datos local (SQLite por defecto)
AICOS_DATABASE_URL=file:./data/aicos.sqlite
